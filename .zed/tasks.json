// Run with "task: spawn" (alt-shift-t). Needs sbt on PATH (Coursier: `cs setup`).
[
  {
    "label": "sbt test",
    "command": "sbt test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    // Bound to the ▶ next to a `@main` (tag from the Scala extension), runs exactly that main.
    "label": "sbt runMain $ZED_CUSTOM_scala_package_name.$ZED_CUSTOM_scala_main_function_name",
    "command": "sbt --client \"runMain $ZED_CUSTOM_scala_package_name.$ZED_CUSTOM_scala_main_function_name\"",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["scala-main"]
  },
  {
    "label": "Part 1: run (naive handler vs sharded Dad)",
    "command": "sbt part1-actors/run",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 1: test",
    "command": "sbt part1-actors/test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 2: run (three nodes in one JVM)",
    "command": "sbt part2-messaging/run",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 2: test",
    "command": "sbt part2-messaging/test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    // One terminal per node, so all three run side by side. Start node 0 first.
    "label": "Part 2: node 0",
    "command": "bash scripts/node.sh 2 0",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 2: node 1",
    "command": "bash scripts/node.sh 2 1",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 2: node 2",
    "command": "bash scripts/node.sh 2 2",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Postgres: start (docker compose up -d)",
    "command": "docker compose up -d --wait",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 3: run (crash a node in one JVM)",
    "command": "sbt part3-delivery/run",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 3: test",
    "command": "sbt part3-delivery/test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 3: node 0",
    "command": "bash scripts/node.sh 3 0",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 3: node 1",
    "command": "bash scripts/node.sh 3 1",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 3: node 2",
    "command": "bash scripts/node.sh 3 2",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    // Run after changing build.sbt: Metals (Zed's Scala language server) builds through Bloop and only sees the
    // modules listed in .bloop/. Zed doesn't always show Metals' "Import build" prompt.
    "label": "Metals: import build (sbt bloopInstall)",
    "command": "sbt bloopInstall",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "scalafmt",
    "command": "sbt scalafmtAll scalafmtSbt",
    "use_new_terminal": false,
    "reveal": "always"
  }
]
