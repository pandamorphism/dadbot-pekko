// Run with "task: spawn" (alt-shift-t). Needs sbt on PATH (Coursier: `cs setup`).
[
  {
    "label": "sbt test",
    "command": "sbt test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    // Bound to the ▶ next to a `@main` (tag from the Scala extension), runs exactly that main.
    "label": "sbt runMain $ZED_CUSTOM_scala_package_name.$ZED_CUSTOM_scala_main_function_name",
    "command": "sbt --client \"runMain $ZED_CUSTOM_scala_package_name.$ZED_CUSTOM_scala_main_function_name\"",
    "use_new_terminal": false,
    "reveal": "always",
    "tags": ["scala-main"]
  },
  {
    "label": "Part 1: run (naive handler vs sharded Dad)",
    "command": "sbt part1-actors/run",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 1: test",
    "command": "sbt part1-actors/test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 2: run (three nodes in one JVM)",
    "command": "sbt part2-messaging/run",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "Part 2: test",
    "command": "sbt part2-messaging/test",
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    // One terminal per node, so all three run side by side. Start node 0 first.
    "label": "Part 2: node 0",
    "command": "bash scripts/node.sh 0",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 2: node 1",
    "command": "bash scripts/node.sh 1",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Part 2: node 2",
    "command": "bash scripts/node.sh 2",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "scalafmt",
    "command": "sbt scalafmtAll scalafmtSbt",
    "use_new_terminal": false,
    "reveal": "always"
  }
]
