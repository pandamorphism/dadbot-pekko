<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %-12logger{0} %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Keep Pekko's own startup and cluster chatter out of the demo output. -->
  <logger name="org.apache.pekko" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
